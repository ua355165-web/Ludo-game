rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(id) { return signedIn() && request.auth.uid == id; }
    function roomMember() { return signedIn() && (request.auth.uid == resource.data.hostId || request.auth.uid in resource.data.memberIds); }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create: if self(playerId);
      allow update: if self(playerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'avatar', 'frame', 'badge', 'online', 'updatedAt'
        ]);
      allow delete: if self(playerId);
    }
    match /friends/{friendId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if signedIn() && request.auth.uid in request.resource.data.memberIds;
    }
    match /friendRequests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.fromId
        && request.resource.data.fromId != request.resource.data.toId;
      allow update: if signedIn() && request.auth.uid == resource.data.toId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
    }
    match /roomInvites/{inviteId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.fromId;
      allow update: if signedIn() && request.auth.uid == resource.data.toId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    match /notifications/{notificationId} {
      allow read, update: if signedIn() && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }
    match /rooms/{roomCode} {
      allow read: if roomMember();
      allow create: if signedIn() && request.auth.uid == request.resource.data.hostId
        && request.resource.data.capacity in [2, 3, 4];
      allow update: if roomMember()
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.capacity == resource.data.capacity;
      allow delete: if signedIn() && request.auth.uid == resource.data.hostId;
      match /quickChat/{messageId} {
        allow read: if roomMember();
        allow create: if roomMember()
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.label in ['Good game!', 'Nice move!', 'Good luck!', 'Well played!', 'Your turn!'];
      }
    }
    match /games/{roomCode} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActionId', 'version']);
    }
    match /wallets/{playerId} {
      allow read: if self(playerId);
      allow write: if false;
    }
    match /inventories/{playerId} {
      allow read: if self(playerId);
      allow write: if false;
    }
    match /leaderboards/{entryId} { allow read: if signedIn(); allow write: if false; }
    match /achievements/{achievementId} { allow read: if signedIn(); allow write: if false; }
  }
}
